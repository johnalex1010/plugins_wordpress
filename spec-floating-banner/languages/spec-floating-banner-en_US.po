msgid "Floating Banners"
msgstr "Floating Banners"

msgid "Configuración del Banner"
msgstr "Banner Settings"

msgid "Tipo de banner"
msgstr "Banner type"

msgid "Tipo de pieza"
msgstr "Piece type"

msgid "Imagen"
msgstr "Image"

msgid "Video"
msgstr "Video"

msgid "Estado"
msgstr "Status"

msgid "Páginas del banner"
msgstr "Banner pages"

msgid "Publicado"
msgstr "Published"

msgid "No publicado"
msgstr "Unpublished"

msgid "Sin páginas asignadas"
msgstr "No assigned pages"

msgid "Página #%d"
msgstr "Page #%d"

msgid "Seleccionar imagen"
msgstr "Select image"

msgid "Seleccionar Imagen"
msgstr "Select Image"

msgid "Cargar video"
msgstr "Upload video"

msgid "Seleccionar video"
msgstr "Select video"

msgid "La imagen es obligatoria para publicar el banner."
msgstr "An image is required to publish the banner."

msgid "Selecciona una imagen antes de guardar el banner."
msgstr "Select an image before saving the banner."

msgid "El video es obligatorio para publicar este banner."
msgstr "A video is required to publish this banner."

msgid "Selecciona un video MP4 o WebM antes de guardar el banner."
msgstr "Select an MP4 or WebM video before saving the banner."

msgid "Enlace del banner"
msgstr "Banner link"

msgid "https://..."
msgstr "https://..."

msgid "El enlace es obligatorio y debe ser una URL válida."
msgstr "The link is required and must be a valid URL."

msgid "El enlace es opcional. Puede ser una URL válida, # o un ancla como #formulario."
msgstr "The link is optional. It can be a valid URL, #, or an anchor like #formulario."

msgid "Nombre CTA"
msgstr "CTA label"

msgid "El nombre del CTA es obligatorio para banners de video."
msgstr "The CTA label is required for video banners."

msgid "Link CTA"
msgstr "CTA link"

msgid "El link del CTA es obligatorio y debe ser una URL válida."
msgstr "The CTA link is required and must be a valid URL."

msgid "El link del CTA es opcional. Puede ser una URL válida, # o un ancla como #formulario."
msgstr "The CTA link is optional. It can be a valid URL, #, or an anchor like #formulario."

msgid "Target CTA"
msgstr "CTA target"

msgid "ID del CTA"
msgstr "CTA ID"

msgid "Opcional. Este ID se puede configurar con GTM para seguimiento de clics."
msgstr "Optional. This ID can be configured with GTM for click tracking."

msgid "Target del enlace"
msgstr "Link target"

msgid "Misma ventana (_self)"
msgstr "Same window (_self)"

msgid "Nueva ventana (_blank)"
msgstr "New window (_blank)"

msgid "Páginas donde está activo un banner flotante"
msgstr "Pages where a floating banner is active"

msgid "Banner flotante"
msgstr "Floating banner"

msgid "Páginas"
msgstr "Pages"

msgid "No hay banners flotantes activos con páginas asignadas."
msgstr "There are no active floating banners with assigned pages."

msgid "Buscar páginas"
msgstr "Search pages"

msgid "Buscar páginas..."
msgstr "Search pages..."

msgid "Páginas disponibles"
msgstr "Available pages"

msgid "No se encontraron páginas con ese criterio."
msgstr "No pages were found with that criterion."

msgid "El banner quedó como borrador porque la imagen y el enlace son obligatorios para publicarlo."
msgstr "The banner was saved as a draft because the image and link are required to publish it."

msgid "El banner quedó como borrador porque faltan campos obligatorios para publicarlo."
msgstr "The banner was saved as a draft because required fields are missing."

msgid "Banner promocional"
msgstr "Promotional banner"

msgid "Cerrar banner"
msgstr "Close banner"
